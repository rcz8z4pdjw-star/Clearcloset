# ==============================================================================
# PREDICTION MARKET RESEARCH PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your values
# Never commit your .env file to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# FLASK / WEB DASHBOARD
# ------------------------------------------------------------------------------
# Secret key for Flask session management (generate with: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=your-secret-key-change-this-in-production

# Dashboard host and port
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# API Authentication (set to enable API key protection)
API_KEY=your-api-key-here
API_KEY_ENABLED=false

# CORS allowed origins (comma-separated, or * for all)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# ------------------------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------------------------
# SQLite database path (relative to project root)
DATABASE_PATH=data/prediction_markets.db

# Parquet data directory
PARQUET_PATH=data/parquet/

# Data retention in days
DATA_RETENTION_DAYS=365

# ------------------------------------------------------------------------------
# PREDICTION MARKET APIs
# ------------------------------------------------------------------------------
# Polymarket API (public, no auth required for basic access)
POLYMARKET_BASE_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com

# Kalshi API
KALSHI_BASE_URL=https://trading-api.kalshi.com/trade-api/v2
KALSHI_API_KEY=
KALSHI_API_SECRET=

# ------------------------------------------------------------------------------
# SOCIAL MEDIA APIs
# ------------------------------------------------------------------------------
# Twitter/X API v2 (https://developer.twitter.com/en/portal/dashboard)
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Reddit API (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=PredictionMarketResearch/1.0

# ------------------------------------------------------------------------------
# ALERT CHANNELS
# ------------------------------------------------------------------------------
# Email alerts (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Webhook alerts (Slack, Discord, etc.)
WEBHOOK_URL=
WEBHOOK_FORMAT=slack

# ------------------------------------------------------------------------------
# EXTERNAL FORECAST SOURCES
# ------------------------------------------------------------------------------
# For forecast aggregation gap strategy
METACULUS_API_KEY=
PREDICTIT_API_KEY=

# ------------------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/platform.log
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=5

# ------------------------------------------------------------------------------
# PERFORMANCE / OPTIMIZATION
# ------------------------------------------------------------------------------
# Number of worker threads for data collection
WORKER_THREADS=4

# Request timeout in seconds
REQUEST_TIMEOUT=30

# Rate limiting (requests per minute)
RATE_LIMIT_RPM=60

# ------------------------------------------------------------------------------
# RISK MANAGEMENT
# ------------------------------------------------------------------------------
# Default Kelly fraction (0.25 = quarter Kelly)
KELLY_FRACTION=0.25

# Maximum single position size (as fraction of portfolio)
MAX_POSITION_SIZE=0.10

# Maximum correlated exposure
MAX_CORRELATED_EXPOSURE=0.25
